{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devpulse",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-09",
  // No SPA fallback: unknown paths get a plain 404.
  "assets": { "directory": "dist", "binding": "ASSETS" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "GITHUB_OWNER": "vincentwesley" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devpulse",
      "database_id": "188754a5-e745-4649-8c5b-6d8ff6396dea",
      "migrations_dir": "migrations"
    }
  ]
}
