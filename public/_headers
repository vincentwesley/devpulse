# Strict headers for Workers Static Assets (served by the assets binding). No external hosts: fonts and the credits image are bundled into /assets/.
# To widen: append one host at a time to connect-src or img-src; never a wildcard, never 'unsafe-inline' for script-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Vite hashed build output (fonts, credits image, js, css all land here).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
